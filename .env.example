# Contact form (Resend) — copy this file to .env.local for dev, or set on the droplet for prod.
# Sign up at https://resend.com to get an API key. The "from" address must be on a verified domain.

RESEND_API_KEY=re_your_api_key_here
CONTACT_FROM=Portfolio <noreply@yourdomain.com>
CONTACT_TO=you@yourdomain.com

# Umami analytics (self-hosted) — only loaded in production.
# NEXT_PUBLIC_ prefix is required so these reach the browser.
NEXT_PUBLIC_UMAMI_SRC=https://analytics.yourdomain.com/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000

# Session replay (Umami v3.1.0+). Loads recorder.js from the same host as the
# tracker (script.js -> recorder.js). Set to "true" to enable, and also turn on
# Replays for this website in the Umami dashboard. Defaults off.
NEXT_PUBLIC_UMAMI_REPLAY=false
